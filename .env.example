# Copy to .env and adjust if needed (docker compose reads .env automatically).

# Base AAOS image used when building cpd-cuttlefish
CUTTLEFISH_BASE_IMAGE=remotivelabs/remotivelabs-cuttlefish:15.0.0-4

# Override published image tags (local defaults shown)
CUTTLEFISH_IMAGE=cpd-cuttlefish:latest
BRIDGE_IMAGE=cpd-remotive-bridge:latest

# Guest resources
CUTTLEFISH_MEMORY_MB=4096
CUTTLEFISH_CPUS=4
CUTTLEFISH_GPU_MODE=auto

# Remotive topology broker (host-side, bridge uses network_mode: host)
REMOTIVE_BROKER_URL=http://127.0.0.1:50130
REMOTIVE_NAMESPACE=topology-BodyCAN
REMOTIVE_BROKER_API_KEY=

# Cuttlefish ADB as seen from the bridge container (host network → host ports)
CUTTLEFISH_ADB=127.0.0.1:6520
